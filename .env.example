# ─── Database ────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/sitesentry
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/sitesentry
MONGODB_URI=mongodb://127.0.0.1:27017/sitesentry

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000

# ─── AI provider ─────────────────────────────────────────────────────────────
# These three variables are the ONLY thing that decides which model analyzes a
# scan. Swap them and restart — no code changes.
#
# Claude (Anthropic):
AI_API_BASE_URL=https://api.anthropic.com
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-opus-5
#
# GPT (OpenAI) — comment out the block above and use these instead:
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o
#
# Any OpenAI-compatible gateway works too (OpenRouter, Together, vLLM, LiteLLM,
# Azure OpenAI). The wire format is inferred from the base URL; set AI_PROVIDER
# explicitly when the hostname doesn't reveal it.
# AI_PROVIDER=openai        # "anthropic" | "openai"

# Optional tuning
# AI_MAX_TOKENS=8000
# AI_TIMEOUT_MS=180000

# ─── Scanner ─────────────────────────────────────────────────────────────────
# Allows scanning localhost and private IPs. Development only — this disables
# the SSRF protection that stops the scanner reaching internal services.
# ALLOW_PRIVATE_SCAN_TARGETS=false
