# ─── Storage ─────────────────────────────────────────────────────────────────
# SQLite lives on disk with the screenshots. Defaults to ./.data — point this at
# a persistent volume in a deployment, or the map history is lost on redeploy.
# AISCENTRY_DATA_DIR=/var/lib/aiscentry

# ─── AI provider ─────────────────────────────────────────────────────────────
# Needed to compile plain-English scenarios into steps, and to repair a selector
# that stops matching. NOT needed to run an already-compiled scenario.
#
# Claude (Anthropic):
AI_API_BASE_URL=https://api.anthropic.com
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-opus-5
#
# GPT (OpenAI) — comment out the block above and use these instead:
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o
#
# Any OpenAI-compatible gateway works too (OpenRouter, Together, vLLM, LiteLLM,
# Azure OpenAI). The wire format is inferred from the base URL; set AI_PROVIDER
# explicitly when the hostname does not reveal it.
# AI_PROVIDER=openai        # "anthropic" | "openai"

# Optional tuning
# AI_MAX_TOKENS=4000
# AI_TIMEOUT_MS=120000

# Refuse to call the model mid-run even when a key is set. Useful for proving a
# scenario replays deterministically.
# DISABLE_AI_REPAIR=true

# ─── Crawler ─────────────────────────────────────────────────────────────────
# Allows mapping localhost and private IPs. Development only — this disables the
# SSRF protection that stops the crawler reaching internal services.
# ALLOW_PRIVATE_TARGETS=false

# Chromium jobs are memory-hungry; this caps how many run at once.
# MAX_CONCURRENT_JOBS=2

# Point at a system Chromium when the bundled Playwright build is unavailable.
# Left unset, the app falls back to whatever Chromium it finds under
# PLAYWRIGHT_BROWSERS_PATH.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
